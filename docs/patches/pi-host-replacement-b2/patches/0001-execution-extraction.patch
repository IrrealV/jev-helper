+import {
+	type AssistantMessage,
+	type AssistantMessageEvent,
+	EventStream,
+	type Message,
+	type Model,
+	type Usage,
+} from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { describe, expect, it } from "vitest";
+import { runAgentLoop } from "../src/agent-loop.ts";
+import {
+	type ExecutedToolCallOutcome,
+	executePreparedToolCall,
+	type FinalizedToolCallOutcome,
+	finalizeExecutedToolCall,
+	type ImmediateToolCallOutcome,
+	type PreparedToolCall,
+	prepareToolCall,
+} from "../src/index.ts";
+import type {
+	AgentContext,
+	AgentEvent,
+	AgentLoopConfig,
+	AgentTool,
+	AgentToolCall,
+	AgentToolResult,
+	AgentToolUpdateCallback,
+} from "../src/types.ts";
+
+const schema = Type.Object({ value: Type.String({ minLength: 1 }) });
+type TestTool = AgentTool<typeof schema, unknown>;
+
+function usage(input = 1): Usage {
+	return {
+		input,
+		output: 2,
+		cacheRead: 0,
+		cacheWrite: 0,
+		totalTokens: input + 2,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+	};
+}
+
+function result(text = "done"): AgentToolResult<unknown> {
+	return { content: [{ type: "text", text }], details: { original: true }, usage: usage() };
+}
+
+function tool(overrides: Partial<TestTool> = {}): TestTool {
+	return {
+		name: "echo",
+		label: "Echo",
+		description: "In-process test tool",
+		parameters: schema,
+		execute: async () => result(),
+		...overrides,
+	};
+}
+
+function call(id = "first", value = "valid"): AgentToolCall {
+	return { type: "toolCall", id, name: "echo", arguments: { value } };
+}
+
+function assistant(calls: AgentToolCall[]): AssistantMessage {
+	return {
+		role: "assistant",
+		content: calls,
+		api: "openai-responses",
+		provider: "openai",
+		model: "mock",
+		usage: usage(0),
+		stopReason: calls.length ? "toolUse" : "stop",
+		timestamp: 1,
+	};
+}
+
+function config(overrides: Partial<AgentLoopConfig> = {}): AgentLoopConfig {
+	const model: Model<"openai-responses"> = {
+		id: "mock",
+		name: "mock",
+		api: "openai-responses",
+		provider: "openai",
+		baseUrl: "https://example.invalid",
+		reasoning: false,
+		input: ["text"],
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+		contextWindow: 8192,
+		maxTokens: 2048,
+	};
+	return {
+		model,
+		convertToLlm: (messages) => messages.filter((message): message is Message =>
+			message.role === "system" || message.role === "user" || message.role === "assistant" || message.role === "toolResult",
+		),
+		...overrides,
+	};
+}
+
+function deferred() {
+	let resolve!: () => void;
+	const promise = new Promise<void>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
+}
+
+// This characterization uses the existing public loop before and after extraction.
+async function run(
+	tools: TestTool[],
+	calls = [call()],
+	overrides: Partial<AgentLoopConfig> = {},
+	signal?: AbortSignal,
+	onEvent?: (event: AgentEvent) => void | Promise<void>,
+) {
+	const events: AgentEvent[] = [];
+	const request = assistant(calls);
+	let requests = 0;
+	const messages = await runAgentLoop(
+		[{ role: "user", content: "exercise inline tools", timestamp: 0 }],
+		{ messages: [], tools },
+		config(overrides),
+		async (event) => {
+			events.push(event);
+			await onEvent?.(event);
+		},
+		signal,
+		() => {
+			const stream = new EventStream<AssistantMessageEvent, AssistantMessage>(
+				(event) => event.type === "done",
+				(event) => {
+					if (event.type !== "done") throw new Error("Expected done");
+					return event.message;
+				},
+			);
+			const message = requests++ === 0 ? request : assistant([]);
+			stream.push({ type: "done", reason: requests === 1 ? "toolUse" : "stop", message });
+			return stream;
+		},
+	);
+	return {
+		events, messages, requests, request,
+		results: messages.filter((message) => message.role === "toolResult"),
+		ends: events.filter((event) => event.type === "tool_execution_end"),
+	};
+}
+
+describe("tool pipeline through the public loop", () => {
+	it("should prepare before validation and expose original calls with mutable validated arguments", async () => {
+		const trace: unknown[] = [];
+		const raw = call();
+		raw.arguments = { legacy: "raw" };
+		const controller = new AbortController();
+		const observed = await run([tool({
+			prepareArguments: (args) => {
+				trace.push(["prepare", args]);
+				return { value: "prepared" };
+			},
+			execute: async (id, args, signal) => {
+				trace.push(["execute", id, args.value, signal]);
+				return result();
+			},
+		})], [raw], {
+			beforeToolCall: async ({ args, toolCall, assistantMessage }, signal) => {
+				trace.push(["before", structuredClone(args), toolCall === raw, assistantMessage.content[0] === raw, signal]);
+				(args as { value: string | number }).value = 123;
+				return undefined;
+			},
+			afterToolCall: async ({ args }) => { trace.push(["after", args]); return undefined; },
+		}, controller.signal, (event) => {
+			if (event.type === "tool_execution_start") trace.push(["start", event.args]);
+		});
+
+		expect(trace).toEqual([
+			["start", { legacy: "raw" }], ["prepare", { legacy: "raw" }],
+			["before", { value: "prepared" }, true, true, controller.signal],
+			["execute", "first", 123, controller.signal], ["after", { value: 123 }],
+		]);
+		expect(raw.arguments).toEqual({ legacy: "raw" });
+		expect(observed.results[0].isError).toBe(false);
+	});
+
+	it("should reject prepared arguments before either hook or execution", async () => {
+		const visited: string[] = [];
+		const observed = await run([tool({
+			prepareArguments: () => { visited.push("prepare"); return { value: "" }; },
+			execute: async () => { visited.push("execute"); return result(); },
+		})], [call()], {
+			beforeToolCall: async () => { visited.push("before"); return undefined; },
+			afterToolCall: async () => { visited.push("after"); return undefined; },
+		});
+		expect(visited).toEqual(["prepare"]);
+		expect(observed.results[0].isError).toBe(true);
+		expect(observed.results[0].content).toEqual([{ type: "text", text: expect.stringContaining("value") }]);
+		expect(observed.requests).toBe(2);
+	});
+
+	it("should normalize an unknown tool without invoking hooks", async () => {
+		const visited: string[] = [];
+		const observed = await run([], [call()], {
+			beforeToolCall: async () => { visited.push("before"); return undefined; },
+			afterToolCall: async () => { visited.push("after"); return undefined; },
+		});
+		expect(visited).toEqual([]);
+		expect(observed.results[0]).toMatchObject({ isError: true, content: [{ type: "text", text: "Tool echo not found" }], details: {} });
+	});
+
+	it.each([
+		["prepare", true], ["prepare", false], ["before", true], ["before", false],
+		["execute", true], ["execute", false], ["after", true], ["after", false],
+	] as const)("should normalize %s exceptions (Error=%s) without changing hook reachability", async (phase, errorObject) => {
+		const visited: string[] = [];
+		const visit = (step: string) => {
+			visited.push(step);
+			if (step === phase) throw errorObject ? new Error("failed here") : "failed here";
+		};
+		const observed = await run([tool({
+			prepareArguments: () => { visit("prepare"); return { value: "valid" }; },
+			execute: async () => { visit("execute"); return { ...result(), terminate: true }; },
+		})], [call()], {
+			beforeToolCall: async () => { visit("before"); return undefined; },
+			afterToolCall: async () => { visit("after"); return undefined; },
+		});
+		const expectedVisits = phase === "prepare" ? ["prepare"] : phase === "before" ? ["prepare", "before"] : ["prepare", "before", "execute", "after"];
+		expect(visited).toEqual(expectedVisits);
+		expect(observed.ends[0].result).toEqual({ content: [{ type: "text", text: "failed here" }], details: {} });
+		expect(observed.results[0].isError).toBe(true);
+		expect(observed.results[0].usage).toBeUndefined();
+		expect(observed.requests).toBe(2);
+	});
+
+	it.each([undefined, "denied"])("should skip execution and after hooks for a blocked call with reason %s", async (reason) => {
+		const visited: string[] = [];
+		const observed = await run([tool({ execute: async () => { visited.push("execute"); return result(); } })], [call()], {
+			beforeToolCall: async () => ({ block: true, reason, terminate: true }),
+			afterToolCall: async () => { visited.push("after"); return undefined; },
+		});
+		expect(visited).toEqual([]);
+		expect(observed.results[0].content).toEqual([{ type: "text", text: reason ?? "Tool execution was blocked" }]);
+		expect(observed.ends[0].result.terminate).toBe(true);
+		expect(observed.results[0]).not.toHaveProperty("terminate");
+		expect(observed.requests).toBe(1);
+	});
