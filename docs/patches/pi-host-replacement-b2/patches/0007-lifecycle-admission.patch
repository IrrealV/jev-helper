+import type { Usage } from "@earendil-works/pi-ai/compat";
+import { describe, expect, it } from "vitest";
+import type { ToolInvocationResult } from "../../src/index.ts";
+import { createLifecycleFixture, finalUsage, type PausePoint, rawUsage } from "./host-invocation-lifecycle-fixture.ts";
+
+type Fixture = Awaited<ReturnType<typeof createLifecycleFixture>>;
+type Owner = ReturnType<Fixture["startOwner"]>;
+
+function expectDenied(result: ToolInvocationResult, message = "B1 lifecycle: denied result") {
+	expect(result.isError, message).toBe(true);
+	expect(result.content).not.toEqual([{ type: "text", text: "usable target content" }]);
+	expect(result.content).not.toEqual([{ type: "text", text: "usable final content" }]);
+	expect("usage" in result).toBe(false);
+}
+
+async function finishOwner(owner: Owner) {
+	owner.state.finish.release();
+	await owner.prompt;
+	expect(owner.state.returned).toBe(true);
+}
+
+async function expectFreshOwner(f: Fixture) {
+	const owner = f.startOwner();
+	const ctx = await f.wait(owner.state.entered.promise, owner.prompt);
+	expect(ctx.signal?.aborted).toBe(false);
+	expect(ctx.cwd).toBe(f.cwd);
+	expect(owner.state.attempts).toBe(0);
+	owner.state.proceed.release();
+	const result = await f.wait(owner.state.result.promise, owner.prompt);
+	expect(result.isError).toBe(false);
+	expect(result.content).toEqual([{ type: "text", text: "usable target content" }]);
+	expect("usage" in result).toBe(false);
+	await finishOwner(owner);
+}
+
+function expectOneContribution(f: Fixture, usage: Usage) {
+	const model = { input: 0, output: 0, cost: 0 };
+	for (const message of f.session.messages) {
+		if (message.role !== "assistant") continue;
+		model.input += message.usage.input;
+		model.output += message.usage.output;
+		model.cost += message.usage.cost.total;
+	}
+	const stats = f.session.getSessionStats();
+	expect(stats.tokens.input).toBe(model.input + usage.input);
+	expect(stats.tokens.output).toBe(model.output + usage.output);
+	expect(stats.cost).toBe(model.cost + usage.cost.total);
+	expect(stats.toolInvocations.known).toBe(1);
+	expect(stats.toolInvocations.pending).toBe(0);
+	expect(stats.toolInvocations.notEntered).toBe(0);
+	// Reading stats twice must not reapply the same retained contribution.
+	expect(f.session.getSessionStats()).toEqual(stats);
+}
+
+const windows: Array<{ id: string; title: string; transition: "reload" | "runtime-dispose"; point: PausePoint }> = [
+	{ id: "B1-01", title: "should deny an unused owner during reload shutdown [B1-01]", transition: "reload", point: "owner" },
+	{ id: "B1-02", title: "should deny an unused owner during runtime shutdown [B1-02]", transition: "runtime-dispose", point: "owner" },
+	{ id: "B1-03", title: "should deny policy continuation during reload shutdown [B1-03]", transition: "reload", point: "policy" },
+	{ id: "B1-04", title: "should deny policy continuation during runtime shutdown [B1-04]", transition: "runtime-dispose", point: "policy" },
+	{ id: "B1-05", title: "should deny preparation continuation during reload shutdown [B1-05]", transition: "reload", point: "preparation" },
+	{ id: "B1-06", title: "should deny preparation continuation during runtime shutdown [B1-06]", transition: "runtime-dispose", point: "preparation" },
+	{ id: "B1-07", title: "should retain raw usage but deny late execution content during reload [B1-07]", transition: "reload", point: "execution" },
+	{ id: "B1-08", title: "should retain raw usage but deny late execution content during runtime disposal [B1-08]", transition: "runtime-dispose", point: "execution" },
+	{ id: "B1-09", title: "should retain final usage but deny late finalized content during reload [B1-09]", transition: "reload", point: "finalization" },
+	{ id: "B1-10", title: "should retain final usage but deny late finalized content during runtime disposal [B1-10]", transition: "runtime-dispose", point: "finalization" },
+];
+
+describe("AgentSession B1 invocation lifecycle", () => {
+	// Literal ordinary it titles: no parameterized formatter/quoting/truncation of declared IDs.
+	for (const scenario of windows) {
+		it(scenario.title, async () => {
+			const f = await createLifecycleFixture(scenario.point);
+			try {
+				const owner = f.startOwner();
+				const ctx = await f.wait(owner.state.entered.promise, owner.prompt);
+				const runner = f.session.extensionRunner;
+				const registrations = runner.getAllRegisteredTools();
+				if (scenario.point !== "owner") {
+					owner.state.proceed.release();
+					await f.wait(f.checkpoint.entered, owner.prompt);
+				}
+				const shutdown = f.pauseShutdown();
+				const transition = f.own(scenario.transition === "reload" ? f.session.reload() : f.runtime.dispose());
+				await f.wait(shutdown.entered, transition);
+
+				// These preconditions must pass BEFORE the intended RED assertion.
+				// The owner is still executing; shutdown has not yet invalidated or aborted it.
+				expect(shutdown.released).toBe(false);
+				expect(f.lifecycle).toContain(`shutdown:1:${scenario.transition === "reload" ? "reload" : "quit"}`);
+				expect(owner.state.returned).toBe(false);
+				expect(owner.state.attempts).toBe(scenario.point === "owner" ? 0 : 1);
+				expect(ctx.signal?.aborted).toBe(false);
+				expect(ctx.cwd).toBe(f.cwd);
+				expect(f.session.extensionRunner).toBe(runner);
+				expect(f.session.getActiveToolNames().sort()).toEqual(["owner", "target"]);
+				for (const registration of registrations) {
+					expect(runner.getAllRegisteredTools().find((tool) => tool.definition.name === registration.definition.name)).toBe(registration);
+				}
+				expect(f.policyRequests).toHaveLength(scenario.point === "owner" ? 0 : 1);
+				if (scenario.point !== "owner") {
+					expect(f.policyRequests[0].caller).toBe(registrations.find((tool) => tool.definition.name === "owner"));
+					expect(f.policyRequests[0].target).toBe(registrations.find((tool) => tool.definition.name === "target"));
+				}
+				const enteredTarget = scenario.point === "execution" || scenario.point === "finalization";
+				expect(f.effects).toEqual(enteredTarget ? ["target"] : []);
+
+				if (scenario.point === "owner") owner.state.proceed.release();
+				else f.checkpoint.release();
+				const result = await f.wait(owner.state.result.promise, owner.prompt);
+				expect(owner.state.attempts).toBe(1);
+				expect(owner.state.returned).toBe(false);
+				expect(ctx.signal?.aborted).toBe(false);
+				expect(shutdown.released).toBe(false);
+				// A2 returns usable content here: neither origin nor existing liveness checks close this window.
+				expectDenied(result, `B1 lifecycle: ${scenario.id} denied content`);
+				expect(f.effects).toEqual(enteredTarget ? ["target"] : []);
+				const records = f.session.getToolInvocationRecords();
+				expect(records).toHaveLength(1);
+				expect(records[0]).toMatchObject({ status: "denied", execution: enteredTarget ? "entered" : "not-entered" });
+				if (enteredTarget) {
+					expect(records[0].rawUsage).toEqual({ state: "known", usage: rawUsage });
+					if (scenario.point === "finalization") {
+						expect(records[0].finalUsage).toEqual({ state: "known", usage: finalUsage });
+					}
+					expectOneContribution(f, scenario.point === "finalization" ? finalUsage : rawUsage);
+				} else {
+					expect(records[0].rawUsage).toEqual({ state: "not-entered" });
+					expect(records[0].finalUsage).toEqual({ state: "not-entered" });
+				}
+				await finishOwner(owner);
+				shutdown.release();
+				await transition;
+			} finally {
+				await f.cleanup();
+			}
+		});
+	}
+
+	it("should preserve ordinary owning invocation and exact policy identity [B1-11]", async () => {
+		const f = await createLifecycleFixture();
+		try {
+			const registrations = f.session.extensionRunner.getAllRegisteredTools();
+			await expectFreshOwner(f);
+			expect(f.effects).toEqual(["target"]);
+			expect(f.policyRequests).toHaveLength(1);
+			expect(f.policyRequests[0]).toMatchObject({ cwd: f.cwd, sessionId: f.session.sessionId, parentToolCallId: "b1-root-1" });
+			expect(f.policyRequests[0].caller).toBe(registrations.find((tool) => tool.definition.name === "owner"));
+			expect(f.policyRequests[0].target).toBe(registrations.find((tool) => tool.definition.name === "target"));
+			expect(f.session.model?.api).toBe("b3b-lifecycle-faux");
+			expect(f.session.model?.provider).toBe("anthropic");
