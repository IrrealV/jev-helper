+			expect(ctx.signal?.aborted).toBe(false);
+			expectDenied(result, "B1 lifecycle: B1-18 disposal remains terminal");
+			expect(f.effects).toEqual([]);
+			await finishOwner(owner);
+		} finally { await f.cleanup(); }
+	});
+
+	it("should preserve direct disposal denial for a still executing owner [B1-19]", async () => {
+		const f = await createLifecycleFixture();
+		try {
+			const owner = f.startOwner();
+			const ctx = await f.wait(owner.state.entered.promise, owner.prompt);
