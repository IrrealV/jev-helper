+++ b/packages/coding-agent/test/suite/agent-session-tool-pipeline.test.ts
@@ -0,0 +1,93 @@
+import { fauxAssistantMessage, fauxToolCall, type Usage } from "@earendil-works/pi-ai/compat";
+import { Type } from "typebox";
+import { describe, expect, it } from "vitest";
+import { AgentSession, type ExtensionFactory, type ToolResultEvent } from "../../src/index.ts";
+import { createTestExtensionsResult, createTestResourceLoader } from "../utilities.ts";
+import { createHarness } from "./harness.ts";
+
+const toolUsage: Usage = {
+	input: 3, output: 2, cacheRead: 0, cacheWrite: 0, totalTokens: 5,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+
+// Real AgentSession, registered tools and extension interception; only the model is faux.
+describe("ordinary AgentSession tool pipeline", () => {
+	it.each(["plain", "intercept", "deny", "error", "non-error", "result-error"] as const)(
+		"should preserve registered-tool transcript and interception behavior (%s)", async (mode) => {
+			const visits: string[] = [];
+			const results: ToolResultEvent[] = [];
+			const errors: string[] = [];
+			const factory: ExtensionFactory = (pi) => {
+				pi.registerTool({
+					name: "seam_echo", label: "Seam echo", description: "Synthetic text-only tool",
+					parameters: Type.Object({ value: Type.String() }),
+					prepareArguments: () => { visits.push("prepare"); return { value: "prepared" }; },
+					execute: async (_id, args) => {
+						visits.push(`execute:${args.value}`);
+						return { content: [{ type: "text", text: args.value }], details: { original: true }, usage: toolUsage };
+					},
+				});
+				if (mode === "plain") return;
+				pi.on("tool_call", (event) => {
+					visits.push("before");
+					expect(event.input).toEqual({ value: "prepared" });
+					if (mode === "deny") return { block: true, reason: "denied" };
+					if (mode === "error") throw new Error("before failed");
+					if (mode === "non-error") throw "before failed";
+					if (!("value" in event.input)) throw new Error("Expected synthetic value input");
+					event.input.value = "mutated";
+				});
+				pi.on("tool_result", (event) => {
+					visits.push("after");
+					results.push(event);
+					if (mode === "result-error") throw new Error("result handler failed");
+					return { content: [{ type: "text", text: "intercepted" }], details: { replacement: true }, isError: true };
+				});
+			};
+			// Explicit empty offline resources, no default tools or file-backed auth/settings/session.
+			const extensionsResult = await createTestExtensionsResult([factory]);
+			const harness = await createHarness({
+				tools: [], resourceLoader: createTestResourceLoader({ extensionsResult }),
+				settings: { retry: { enabled: false }, compaction: { enabled: false } },
+			});
+			try {
+				expect(harness.session).toBeInstanceOf(AgentSession);
+				expect(harness.session.getActiveToolNames()).toEqual(["seam_echo"]);
+				await harness.session.bindExtensions({ onError: (event) => { errors.push(event.error); } });
+				harness.setResponses([
+					fauxAssistantMessage(fauxToolCall("seam_echo", { value: "raw" }, { id: "seam-call" }), { stopReason: "toolUse" }),
+					fauxAssistantMessage("finished"),
+				]);
+
+				await harness.session.prompt("Exercise the synthetic tool", { expandPromptTemplates: false });
+				await harness.session.waitForIdle();
+
+				const denied = mode === "deny" || mode === "error" || mode === "non-error";
+				const text = mode === "plain" ? "prepared" : mode === "intercept" ? "intercepted" : mode === "deny" ? "denied"
+					: mode === "non-error" ? "Extension failed, blocking execution: before failed" : mode === "error" ? "before failed" : "mutated";
+				expect(visits).toEqual(mode === "plain" ? ["prepare", "execute:prepared"] : denied ? ["prepare", "before"] : ["prepare", "before", "execute:mutated", "after"]);
+				const messages = harness.session.messages.filter((message) => message.role !== "system");
+				expect(messages.map((message) => message.role)).toEqual(["user", "assistant", "toolResult", "assistant"]);
+				const toolResults = harness.session.messages.filter((message) => message.role === "toolResult");
+				expect(toolResults).toHaveLength(1);
+				expect(toolResults[0]).toMatchObject({
+					toolCallId: "seam-call", toolName: "seam_echo", content: [{ type: "text", text }],
+					isError: denied || mode === "intercept",
+					details: denied ? {} : mode === "intercept" ? { replacement: true } : { original: true },
+				});
+				expect(toolResults[0].usage).toEqual(denied ? undefined : toolUsage);
+				expect(results).toHaveLength(denied || mode === "plain" ? 0 : 1);
+				if (results.length) expect(results[0]).toMatchObject({ input: { value: "mutated" }, content: [{ type: "text", text: "mutated" }], usage: toolUsage, isError: false });
+				expect(errors).toEqual(mode === "result-error" ? ["result handler failed"] : []);
+				expect(harness.eventsOfType("tool_execution_end")).toHaveLength(1);
+				expect(harness.eventsOfType("agent_settled")).toHaveLength(1);
+				expect(harness.session.isIdle).toBe(true);
+				expect(harness.getPendingResponseCount()).toBe(0);
+				expect(harness.sessionManager.buildSessionContext().messages.filter((message) => message.role === "toolResult")).toEqual(toolResults);
+			} finally {
+				await harness.session.waitForIdle();
+				harness.cleanup();
+			}
+		},
+	);
+});
