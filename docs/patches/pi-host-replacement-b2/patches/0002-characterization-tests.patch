+
+// HP2-B1: captured on the existing public phases before origin-neutral factoring.
+describe("ordinary phase selection and accounting boundaries", () => {
+	it.each(["add", "replace", "remove"] as const)("should select the before hook after argument preparation (%s)", async (change) => {
+		const raw = call();
+		const request = assistant([raw]);
+		const signal = new AbortController().signal;
+		const visits: string[] = [];
+		const settings = config();
+		const context: AgentContext = { messages: [request], tools: [tool({
+			prepareArguments: () => {
+				settings.beforeToolCall = change === "remove" ? undefined : async function (this: AgentLoopConfig, input, receivedSignal) {
+					visits.push("selected");
+					expect(this).toBe(settings);
+					expect(input.assistantMessage).toBe(request);
+					expect(input.toolCall).toBe(raw);
+					expect(input.context).toBe(context);
+					expect(receivedSignal).toBe(signal);
+					(input.args as { value: string }).value = "mutated";
+					return undefined;
+				};
+				return { value: "prepared" };
+			},
+		})] };
+		if (change !== "add") settings.beforeToolCall = async () => { visits.push("stale"); return { block: true }; };
+
+		const prepared = await prepareToolCall(context, request, raw, settings, signal);
+
+		expect(visits).toEqual(change === "remove" ? [] : ["selected"]);
+		expect(prepared).toMatchObject({ kind: "prepared", args: { value: change === "remove" ? "prepared" : "mutated" } });
+		expect(raw.arguments).toEqual({ value: "valid" });
+	});
+
+	it("should retain ordinary hook getter presence checks and invocation receivers", async () => {
+		const raw = call();
+		const request = assistant([raw]);
+		const context: AgentContext = { messages: [request], tools: [tool()] };
+		const reads: string[] = [];
+		const settings = config();
+		Object.defineProperty(settings, "beforeToolCall", { get() {
+			reads.push("before");
+			return async function (this: AgentLoopConfig) { expect(this).toBe(settings); return undefined; };
+		} });
+		Object.defineProperty(settings, "afterToolCall", { get() {
+			reads.push("after");
+			return async function (this: AgentLoopConfig) { expect(this).toBe(settings); return undefined; };
+		} });
+		const prepared = await prepareToolCall(context, request, raw, settings, undefined);
+		if (prepared.kind !== "prepared") throw new Error("Expected prepared call");
+		const executed = { result: result(), isError: false };
+		const finalized = await finalizeExecutedToolCall(context, request, prepared, executed, settings, undefined);
+		expect(reads).toEqual(["before", "before", "after", "after"]);
+		expect(finalized.result).toBe(executed.result);
+	});
+
+	it.each([false, true])("should reject when an accepted update rejects even in execution catch (throws=%s)", async (throws) => {
+		const release = deferred();
+		const failure = new Error("update rejected");
+		const prepared: PreparedToolCall = { kind: "prepared", toolCall: call(), args: { value: "valid" }, tool: tool({
+			execute: async (_id, _args, _signal, update) => {
+				update?.(result("progress"));
+				if (throws) throw new Error("execution rejected");
+				return result();
+			},
+		}) };
+		const running = executePreparedToolCall(prepared, undefined, async () => {
+			await release.promise;
+			throw failure;
+		});
+		const checked = expect(running).rejects.toBe(failure);
+		// Let execute's await attach Promise.all before releasing the update rejection.
+		await Promise.resolve();
+		release.resolve();
+		await checked;
+	});
+
+	it("should discard prior usage and termination when the ordinary after hook rejects", async () => {
+		const raw = call();
+		const request = assistant([raw]);
+		const original = { ...result(), terminate: true };
+		const prepared: PreparedToolCall = { kind: "prepared", toolCall: raw, tool: tool(), args: raw.arguments };
+		const finalized = await finalizeExecutedToolCall({ messages: [request] }, request, prepared,
+			{ result: original, isError: false }, config({ afterToolCall: async () => { throw new Error("after rejected"); } }), undefined);
+		expect(finalized).toEqual({ toolCall: raw, result: { content: [{ type: "text", text: "after rejected" }], details: {} }, isError: true });
+		expect(original.usage).toEqual(usage());
+	});
+
+	it("should select the current after hook with the original result and validated argument references", async () => {
+		const raw = call();
+		const request = assistant([raw]);
+		const settings = config();
+		const original = result();
+		const context: AgentContext = { messages: [request], tools: [tool()] };
+		const prepared = await prepareToolCall(context, request, raw, settings, undefined);
+		if (prepared.kind !== "prepared") throw new Error("Expected prepared call");
+		settings.afterToolCall = async function (this: AgentLoopConfig, input) {
+			expect(this).toBe(settings);
+			expect(input.assistantMessage).toBe(request);
+			expect(input.context).toBe(context);
+			expect(input.toolCall).toBe(raw);
+			expect(input.args).toBe(prepared.args);
+			expect(input.result).toBe(original);
+			return { usage: usage(11), terminate: false };
+		};
+		const finalized = await finalizeExecutedToolCall(context, request, prepared, { result: original, isError: false }, settings, undefined);
+		expect(finalized.result).toEqual({ ...original, usage: usage(11), terminate: false });
+	});
+});
diff --git a/packages/coding-agent/test/suite/agent-session-tool-pipeline.test.ts b/packages/coding-agent/test/suite/agent-session-tool-pipeline.test.ts
