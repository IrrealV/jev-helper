+};
+
+type PolicyMode = "admit" | "absent" | "false" | "throws";
+
+function deferred() {
+	let resolve!: () => void;
+	const promise = new Promise<void>((fulfill) => { resolve = fulfill; });
+	return { promise, resolve };
+}
+
+async function createFixture(options: {
+	policy?: PolicyMode;
+	unknownUsage?: boolean;
+	retainOnly?: boolean;
+	hooks?: (pi: ExtensionAPI) => void;
+} = {}) {
+	const visits: string[] = [];
+	const effects: string[] = [];
+	const nested: ToolInvocationResult[] = [];
+	const policies: Parameters<ToolInvocationPolicy>[0][] = [];
+	const contexts: ToolExecutionContext[] = [];
+	let parentSignal: AbortSignal | undefined;
+	const target = defineTool({
+		name: "mcpScript", label: "Synthetic script", description: "Text-only synthetic target",
+		parameters: Type.Object({ value: Type.String() }),
+		prepareArguments: () => {
+			visits.push("prepare");
+			return { value: "prepared" };
+		},
+		async execute(_id, args, signal, onUpdate, ctx) {
+			expect(signal).toBe(parentSignal);
+			expect(ctx.signal).toBe(signal);
+			effects.push(args.value);
+			visits.push(`execute:${args.value}`);
+			onUpdate?.({ content: [{ type: "text", text: "progress" }], details: undefined });
+			return {
+				content: [{ type: "text", text: args.value }], details: { raw: true },
+				usage: options.unknownUsage ? undefined : rawUsage,
+			};
+		},
+	});
+	const parent = defineTool({
+		name: "parent", label: "Parent", description: "Synthetic registered parent",
+		parameters: Type.Object({}),
+		async execute(_id, _args, signal, _onUpdate, ctx) {
+			parentSignal = signal;
+			contexts.push(ctx);
+			if (options.retainOnly) return { content: [{ type: "text", text: "retained" }], details: undefined };
+			const result = await ctx.invokeTool("mcpScript", { value: "raw" });
+			nested.push(result);
+			return result;
+		},
+	});
+	const parentExecute = parent.execute;
+	const targetExecute = target.execute;
+	const policy: ToolInvocationPolicy = (request) => {
+		policies.push(request);
+		if (options.policy === "throws") throw new Error("synthetic policy failure");
+		return options.policy !== "false" && request.caller.definition === parent &&
+			request.caller.definition.execute === parentExecute && request.target.definition === target &&
+			request.target.definition.execute === targetExecute;
+	};
+	const harness = await createHarness({
+		tools: [], toolInvocationPolicy: options.policy === "absent" ? undefined : policy,
+		settings: { retry: { enabled: false }, compaction: { enabled: false } },
+		extensionFactories: [(pi) => {
+			pi.registerTool(parent);
+			pi.registerTool(target);
+			options.hooks?.(pi);
+		}],
+	});
+	await harness.session.bindExtensions({});
+	return { harness, visits, effects, nested, policies, contexts, parent, target };
+}
+
+async function runParent(harness: Harness, id = "root-call") {
+	harness.setResponses([
+		fauxAssistantMessage(fauxToolCall("parent", {}, { id }), { stopReason: "toolUse" }),
+		fauxAssistantMessage("finished"),
+	]);
+	await harness.session.prompt("Exercise the registered parent", { expandPromptTemplates: false });
+	await harness.session.waitForIdle();
+}
+
+function modelTotals(harness: Harness) {
+	const totals = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0 };
+	for (const message of harness.session.messages) {
+		if (message.role !== "assistant") continue;
+		totals.input += message.usage.input;
+		totals.output += message.usage.output;
+		totals.cacheRead += message.usage.cacheRead;
+		totals.cacheWrite += message.usage.cacheWrite;
+		totals.cost += message.usage.cost.total;
+	}
+	return totals;
+}
+
+// Bootstrap exception: no meaningful missing-method RED. These are real host executions,
+// not claims about the deferred origin/single-use/lifecycle/exceptional-accounting guards.
+describe("AgentSession host tool invocation bootstrap", () => {
+	it("should dispatch through real hooks and count finalized usage once without another model turn", async () => {
+		const updateEntered = deferred();
+		const releaseUpdate = deferred();
+		const hookVisits: string[] = [];
+		const fixture = await createFixture({ hooks: (pi) => {
+			pi.on("tool_call", (event) => {
+				if (event.toolName !== "mcpScript") return;
+				hookVisits.push("call");
+				expect(event.input).toEqual({ value: "prepared" });
+				event.input.value = "mutated";
+			});
+			pi.on("tool_execution_update", async (event) => {
+				if (event.toolName !== "mcpScript") return;
+				updateEntered.resolve();
+				await releaseUpdate.promise;
+			});
+			pi.on("tool_result", (event) => {
+				if (event.toolName !== "mcpScript") return;
+				hookVisits.push("result");
+				expect(event.input).toEqual({ value: "mutated" });
+				expect(event.content).toEqual([{ type: "text", text: "mutated" }]);
+				expect(event.usage).toEqual(rawUsage);
+				return { content: [{ type: "text", text: "intercepted" }], details: { final: true }, usage: finalUsage };
+			});
+		} });
+		const { harness, effects, nested, visits, policies, contexts } = fixture;
+		const prompt = runParent(harness);
+		try {
+			expect(harness.session).toBeInstanceOf(AgentSession);
+			await Promise.race([
+				updateEntered.promise,
+				prompt.then(() => { throw new Error("Parent finished without entering the nested update"); }),
+			]);
+			// The target promise settles while its accepted update handler is still pending.
+			await new Promise<void>((resolve) => setImmediate(resolve));
+			expect(harness.session.getToolInvocationRecords()[0]).toMatchObject({
+				status: "pending", execution: "entered", rawUsage: { state: "known", usage: rawUsage },
+				finalUsage: { state: "pending" },
+			});
+			expect(harness.session.getSessionStats().toolInvocations.completeness).toBe("pending");
+			releaseUpdate.resolve();
+			await prompt;
+
+			expect(visits).toEqual(["prepare", "execute:mutated"]);
+			expect(hookVisits).toEqual(["call", "result"]);
+			expect(effects).toEqual(["mutated"]);
+			expect(nested).toHaveLength(1);
+			expect(Object.keys(nested[0]).sort()).toEqual(["content", "details", "invocationId", "isError"]);
+			expect(nested[0]).toMatchObject({ content: [{ type: "text", text: "intercepted" }], details: { final: true }, isError: false });
+			expect(nested[0].invocationId).not.toBe("root-call");
+			expect(policies).toHaveLength(1);
+			expect(policies[0]).toMatchObject({ sessionId: harness.session.sessionId, cwd: harness.tempDir, parentToolCallId: "root-call" });
+			expect(policies[0].caller).toBe(harness.session.extensionRunner.getAllRegisteredTools().find((tool) => tool.definition === fixture.parent));
+			expect(policies[0].target).toBe(harness.session.extensionRunner.getAllRegisteredTools().find((tool) => tool.definition === fixture.target));
+			expect(typeof Object.getOwnPropertyDescriptor(contexts[0], "model")?.get).toBe("function");
+			expect("invokeTool" in harness.session.extensionRunner.createContext()).toBe(false);
+			expect("invokeTool" in harness.session.extensionRunner.createCommandContext()).toBe(false);
+
+			const records = harness.session.getToolInvocationRecords();
+			expect(records).toEqual([{
+				invocationId: nested[0].invocationId, sessionId: harness.session.sessionId, cwd: harness.tempDir,
+				parentToolCallId: "root-call", callerName: "parent", targetName: "mcpScript", status: "completed",
+				execution: "entered", isError: false, rawUsage: { state: "known", usage: rawUsage },
+				finalUsage: { state: "known", usage: finalUsage },
+			}]);
+			records[0].callerName = "tampered";
+			if (records[0].finalUsage.state === "known") records[0].finalUsage.usage.cost.total = 999;
+			expect(harness.session.getToolInvocationRecords()[0].callerName).toBe("parent");
+			expect(harness.session.getToolInvocationRecords()[0].finalUsage).toEqual({ state: "known", usage: finalUsage });
+			const model = modelTotals(harness);
+			const stats = harness.session.getSessionStats();
+			expect(stats.tokens).toEqual({ input: model.input + 7, output: model.output + 11,
+				cacheRead: model.cacheRead + 1, cacheWrite: model.cacheWrite + 2,
+				total: model.input + model.output + model.cacheRead + model.cacheWrite + 21 });
+			expect(stats.cost).toBe(model.cost + 4);
+			expect(stats.toolInvocations).toEqual({ scope: "live-session", completeness: "complete", known: 1, unknown: 0, pending: 0, notEntered: 0 });
+			expect(harness.session.messages.filter((message) => message.role !== "system").map((message) => message.role))
+				.toEqual(["user", "assistant", "toolResult", "assistant"]);
+			const toolResults = harness.session.messages.filter((message) => message.role === "toolResult");
+			expect(toolResults).toHaveLength(1);
+			expect(toolResults[0].toolName).toBe("parent");
+			expect(toolResults[0].usage).toBeUndefined();
+			expect(stats.assistantMessages).toBe(2);
+			expect(harness.eventsOfType("tool_execution_end")).toHaveLength(1);
+			expect(harness.eventsOfType("agent_settled")).toHaveLength(1);
+			expect(harness.getPendingResponseCount()).toBe(0);
+		} finally {
+			releaseUpdate.resolve();
+			await prompt;
+			await harness.session.waitForIdle();
+			harness.cleanup();
+		}
+	});
+
+	it.each(["absent", "false", "throws"] as const)("should deny a %s policy before target effects", async (policy) => {
+		const { harness, visits, effects, nested } = await createFixture({ policy });
+		try {
+			await runParent(harness);
+			expect(visits).toEqual([]);
+			expect(effects).toEqual([]);
+			expect(nested).toHaveLength(1);
+			expect(nested[0].isError).toBe(true);
+			expect(Object.keys(nested[0]).sort()).toEqual(["content", "details", "invocationId", "isError"]);
+			expect(harness.session.getToolInvocationRecords()[0]).toMatchObject({
+				status: "denied", execution: "not-entered", rawUsage: { state: "not-entered" }, finalUsage: { state: "not-entered" },
+			});
+			expect(harness.session.getSessionStats().toolInvocations).toEqual({ scope: "live-session", completeness: "complete", known: 0, unknown: 0, pending: 0, notEntered: 1 });
+		} finally { await harness.session.waitForIdle(); harness.cleanup(); }
+	});
+
+	it("should deny a retained invocation after its parent completes", async () => {
+		const { harness, contexts, effects, policies } = await createFixture({ retainOnly: true });
+		try {
+			await runParent(harness);
+			const result = await contexts[0].invokeTool("mcpScript", { value: "late" });
+			expect(result.isError).toBe(true);
+			expect(result.content).toEqual([{ type: "text", text: "Parent tool execution has completed" }]);
+			expect("usage" in result).toBe(false);
+			expect(effects).toEqual([]);
+			expect(policies).toEqual([]);
+		} finally { await harness.session.waitForIdle(); harness.cleanup(); }
+	});
+
+	it("should expose missing usage as unknown rather than zero consumption", async () => {
+		const { harness, effects } = await createFixture({ unknownUsage: true });
+		try {
+			await runParent(harness);
+			expect(effects).toEqual(["prepared"]);
+			expect(harness.session.getToolInvocationRecords()[0]).toMatchObject({
+				execution: "entered", rawUsage: { state: "unknown" }, finalUsage: { state: "unknown" },
+			});
+			expect(harness.session.getSessionStats().toolInvocations).toEqual({ scope: "live-session", completeness: "unknown", known: 0, unknown: 1, pending: 0, notEntered: 0 });
+		} finally { await harness.session.waitForIdle(); harness.cleanup(); }
+	});
+
+	it("should refuse capacity overflow without evicting prior records", async () => {
+		const { harness, nested, effects, policies } = await createFixture();
+		try {
+			// Separate root executions; multiple invocations per parent are not a supported contract.
+			for (let index = 0; index < 128; index++) await runParent(harness, `root-${index}`);
+			const before = harness.session.getToolInvocationRecords();
+			await runParent(harness, "overflow-root");
+			expect(before).toHaveLength(128);
+			expect(harness.session.getToolInvocationRecords()).toEqual(before);
+			expect(nested[128].isError).toBe(true);
+			expect(nested[128].content).toEqual([{ type: "text", text: "Tool invocation ledger is full" }]);
+			expect(effects).toHaveLength(128);
+			expect(policies).toHaveLength(128);
+		} finally { await harness.session.waitForIdle(); harness.cleanup(); }
+	});
+
+	it("should give standalone registered wrappers denial rather than host authority", async () => {
+		const { harness, effects, nested, parent } = await createFixture();
+		try {
+			const registration = harness.session.extensionRunner.getAllRegisteredTools().find((tool) => tool.definition === parent);
+			if (!registration) throw new Error("Missing registered parent");
+			await wrapRegisteredTool(registration, harness.session.extensionRunner).execute("standalone", {}, undefined);
+			expect(nested).toHaveLength(1);
+			expect(nested[0].isError).toBe(true);
+			expect("usage" in nested[0]).toBe(false);
+			expect(effects).toEqual([]);
+			expect(harness.session.getToolInvocationRecords()).toEqual([]);
+		} finally { await harness.session.waitForIdle(); harness.cleanup(); }
+	});
+});
