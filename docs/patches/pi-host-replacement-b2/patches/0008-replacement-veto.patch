+				try {
+					await session.waitForIdle();
+					failures.push(...errors.filter((error, index) => !failBeforeCancel || index > 0 ||
+						error.error !== hookFailure ||
+						(error.event !== "session_before_switch" && error.event !== "session_before_fork")));
+					if (failures.length) throw new AggregateError(failures, "Unexpected B2 fixture failure");
+				} finally { retire(); }
+			},
+		};
+	} catch (error) {
+		const failures = await settle();
+		retire();
+		throw new AggregateError([error, ...failures], "B2 fixture setup failed");
+	}
+}
