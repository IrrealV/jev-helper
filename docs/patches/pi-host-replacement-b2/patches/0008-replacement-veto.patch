@@ -0,0 +1,162 @@
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import type { ToolExecutionContext, ToolInvocationResult } from "../../src/core/extensions/types.ts";
+import { createReplacementFixture, hookFailure, type ReplacementKind } from "./host-invocation-replacement-fixture.ts";
+
+type Fixture = Awaited<ReturnType<typeof createReplacementFixture>>;
+type Owner = ReturnType<Fixture["startOwner"]>;
+
+function authority(f: Fixture) {
+	return { session: f.runtime.session, id: f.session.sessionId, runner: f.session.extensionRunner,
+		registrations: f.session.extensionRunner.getAllRegisteredTools() };
+}
+
+function expectLiveOwner(f: Fixture, owner: Owner, ctx: ToolExecutionContext, saved: ReturnType<typeof authority>) {
+	expect(f.runtime.session).toBe(saved.session);
+	expect(f.session.sessionId).toBe(saved.id);
+	expect(f.session.extensionRunner).toBe(saved.runner);
+	expect(f.session.getActiveToolNames().sort()).toEqual(["owner", "target"]);
+	expect(saved.registrations).toHaveLength(2);
+	for (const registration of saved.registrations) {
+		expect(saved.runner.getAllRegisteredTools().find((tool) => tool.definition.name === registration.definition.name))
+			.toBe(registration);
+	}
+	expect(ctx.cwd).toBe(f.cwd);
+	expect(ctx.signal?.aborted).toBe(false);
+	expect(owner.state.returned).toBe(false);
+	expect(owner.state.attempts).toBe(0);
+}
+
+function expectBeforeEvent(f: Fixture, kind: ReplacementKind) {
+	const event = kind === "fork"
+		? { type: "session_before_fork", entryId: "b2-missing-entry", position: "at" }
+		: { type: "session_before_switch", reason: kind === "new" ? "new" : "resume",
+			targetSessionFile: kind === "new" ? undefined : join(f.cwd, "missing-session.jsonl") };
+	expect(f.beforeEvents).toEqual([event]);
+	expect(f.lifecycle).toEqual(["start:1:startup"]);
+}
+
+async function invokeOwner(f: Fixture, owner: Owner, ctx: ToolExecutionContext) {
+	owner.state.proceed.release();
+	const result = await f.wait(owner.state.result.promise, owner.prompt);
+	expect(owner.state.attempts).toBe(1);
+	expect(owner.state.returned).toBe(false);
+	expect(ctx.signal?.aborted).toBe(false);
+	return result;
+}
+
+function expectDenied(result: ToolInvocationResult, id: string) {
+	expect(result.isError, `${id}: replacement admission must deny`).toBe(true);
+	expect(result.content).not.toEqual([{ type: "text", text: "usable target content" }]);
+	expect("usage" in result).toBe(false);
+}
+
+async function finishOwner(owner: Owner) {
+	owner.state.finish.release();
+	await owner.prompt;
+	expect(owner.state.returned).toBe(true);
+}
+
+async function expectFreshSuccess(f: Fixture) {
+	const saved = authority(f);
+	const owner = f.startOwner();
+	const ctx = await f.wait(owner.state.entered.promise, owner.prompt);
+	expectLiveOwner(f, owner, ctx, saved);
+	const result = await invokeOwner(f, owner, ctx);
+	expect(result.isError).toBe(false);
+	expect(result.content).toEqual([{ type: "text", text: "usable target content" }]);
+	await finishOwner(owner);
+	expect(f.effects).toEqual(["target"]);
+}
+
+const windows: Array<{ id: string; kind: ReplacementKind; window: "pending" | "stale" | "closed-born" }> = [
+	{ id: "B2-01", kind: "new", window: "pending" },
+	{ id: "B2-02", kind: "switch", window: "pending" },
+	{ id: "B2-03", kind: "fork", window: "pending" },
+	{ id: "B2-04", kind: "new", window: "stale" },
+	{ id: "B2-05", kind: "switch", window: "stale" },
+	{ id: "B2-06", kind: "fork", window: "stale" },
+	{ id: "B2-07", kind: "new", window: "closed-born" },
+	{ id: "B2-08", kind: "switch", window: "closed-born" },
+	{ id: "B2-09", kind: "fork", window: "closed-born" },
+];
+
+describe("AgentSession B2 invocation replacement", () => {
+	for (const scenario of windows) {
+		it(`should deny ${scenario.window} owner for ${scenario.kind} and admit fresh after veto [${scenario.id}]`, async () => {
+			const f = await createReplacementFixture();
+			try {
+				const saved = authority(f);
+				const earlyOwner = scenario.window === "closed-born" ? undefined : f.startOwner();
+				if (earlyOwner) await f.wait(earlyOwner.state.entered.promise, earlyOwner.prompt);
+				const transition = f.begin(scenario.kind);
+				await f.wait(f.before.entered, transition);
+				const owner = earlyOwner ?? f.startOwner();
+				const ctx = await f.wait(owner.state.entered.promise, owner.prompt);
+
+				// Checkpoint/identity/liveness precede the intended denial assertion.
+				expectBeforeEvent(f, scenario.kind);
+				expect(f.before.released).toBe(false);
+				expectLiveOwner(f, owner, ctx, saved);
+				expect(f.effects).toEqual([]);
+				if (scenario.window !== "pending") {
+					f.before.release();
+					await expect(transition).resolves.toEqual({ cancelled: true });
+					expectLiveOwner(f, owner, ctx, saved);
+				}
+				const result = await invokeOwner(f, owner, ctx);
+				expect(f.before.released).toBe(scenario.window !== "pending");
+				expectDenied(result, scenario.id);
+				expect(f.effects).toEqual([]);
+				await finishOwner(owner);
+				f.before.release();
+				await expect(transition).resolves.toEqual({ cancelled: true });
+				expectBeforeEvent(f, scenario.kind);
+				expect(f.errors).toEqual([]);
+				await expectFreshSuccess(f);
+			} finally { await f.cleanup(); }
+		});
+	}
+
+	for (const scenario of [
+		{ id: "B2-10", kind: "new" },
+		{ id: "B2-11", kind: "switch" },
+		{ id: "B2-12", kind: "fork" },
+	] satisfies Array<{ id: string; kind: ReplacementKind }>) {
+		it(`should keep ${scenario.kind} hook-error veto closed until reload [${scenario.id}]`, async () => {
+			const f = await createReplacementFixture(true);
+			try {
+				const saved = authority(f);
+				const transition = f.begin(scenario.kind);
+				await f.wait(f.before.entered, transition);
+				expectBeforeEvent(f, scenario.kind);
+				expect(f.before.released).toBe(false);
+				expect(f.errors.map(({ event, error }) => ({ event, error }))).toEqual([{
+					event: scenario.kind === "fork" ? "session_before_fork" : "session_before_switch", error: hookFailure,
+				}]);
+				f.before.release();
+				await expect(transition).resolves.toEqual({ cancelled: true });
+				const owner = f.startOwner();
+				const ctx = await f.wait(owner.state.entered.promise, owner.prompt);
+				expectLiveOwner(f, owner, ctx, saved);
+				expectDenied(await invokeOwner(f, owner, ctx), scenario.id);
+				expect(f.effects).toEqual([]);
+				await finishOwner(owner);
+				await f.own(f.session.reload());
+				expect(f.runtime.session).toBe(saved.session);
+				expect(f.session.extensionRunner).not.toBe(saved.runner);
+				expect(f.lifecycle).toEqual(["start:1:startup", "shutdown:1:reload", "loader:2", "start:2:reload"]);
+				await expectFreshSuccess(f);
+			} finally { await f.cleanup(); }
+		});
+	}
+
+	it("should admit an ordinary owner before replacement [B2-13]", async () => {
+		const f = await createReplacementFixture();
+		try {
+			await expectFreshSuccess(f);
+			expect(f.beforeEvents).toEqual([]);
+			expect(f.errors).toEqual([]);
+		} finally { await f.cleanup(); }
+	});
+});
