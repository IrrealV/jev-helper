+import { SettingsManager } from "../../src/core/settings-manager.ts";
+
+export type ReplacementKind = "new" | "switch" | "fork";
+export const hookFailure = "B2 intentional before-hook failure";
+
+function deferred<T>() {
+	let resolve!: (value: T) => void;
+	const promise = new Promise<T>((fulfill) => { resolve = fulfill; });
+	return { promise, resolve };
+}
+
+function gate() {
+	const entered = deferred<void>();
+	const resume = deferred<void>();
+	let released = false;
+	return {
+		entered: entered.promise,
+		get released() { return released; },
+		release() { released = true; resume.resolve(); },
+		async wait() { entered.resolve(); await resume.promise; },
+	};
+}
+
+type Gate = ReturnType<typeof gate>;
+type OwnerState = {
+	entered: ReturnType<typeof deferred<ToolExecutionContext>>;
+	result: ReturnType<typeof deferred<ToolInvocationResult>>;
+	proceed: Gate;
+	finish: Gate;
+	attempts: number;
+	returned: boolean;
+};
+
+function textResult(text: string): AgentToolResult<undefined> {
+	return { content: [{ type: "text", text }], details: undefined };
+}
+
+/** Offline transport only; all invocation authority comes from the real registered owner. */
+export async function createReplacementFixture(failBeforeCancel = false) {
+	const cwd = mkdtempSync(join(tmpdir(), "pi-b2-replacement-"));
+	const gates: Gate[] = [];
+	const pending: Promise<unknown>[] = [];
+	const owners: OwnerState[] = [];
+	const effects: string[] = [];
+	const lifecycle: string[] = [];
+	const errors: ExtensionError[] = [];
+	const beforeEvents: Array<SessionBeforeSwitchEvent | SessionBeforeForkEvent> = [];
+	let currentFaux: FauxProviderRegistration | undefined;
+	let createdSession: AgentSession | undefined;
+	let rootId = 0;
+	let generation = 0;
+
+	function own<T>(promise: Promise<T>): Promise<T> {
+		pending.push(promise);
+		// Observe rejection immediately; retain the original disposition for assertions/cleanup.
+		void promise.catch(() => {});
+		return promise;
+	}
+	function newGate(): Gate {
+		const pause = gate();
+		gates.push(pause);
+		return pause;
+	}
+	function faux(): FauxProviderRegistration {
+		if (!currentFaux) throw new Error("B2 fixture has no current faux transport");
+		return currentFaux;
+	}
+	function installFaux() {
+		// Reload is only requested after owner prompts settle; retire before replacing the handle.
+		currentFaux?.unregister();
+		currentFaux = registerFauxProvider({
+			api: "b3b-replacement-faux", provider: "anthropic",
+			models: [{ id: "b3b-replacement", input: ["text"], reasoning: false }],
+		});
+		currentFaux.setResponses([fauxAssistantMessage("reload transport complete")]);
+		return currentFaux;
+	}
+
+	const before = newGate();
+	const factory: ExtensionFactory = (pi) => {
+		const factoryGeneration = ++generation;
+		pi.registerTool(defineTool({
+			name: "owner", label: "Owner", description: "Replacement lifecycle owner", parameters: Type.Object({}),
+			async execute(_id, _args, _signal, _update, ctx) {
+				const state = owners.shift();
+				if (!state) throw new Error("Unplanned B2 owner execution");
+				try {
+					state.entered.resolve(ctx);
+					await state.proceed.wait();
+					state.attempts++;
+					state.result.resolve(await own(ctx.invokeTool("target", {})));
+					await state.finish.wait();
+					return textResult("owner complete");
+				} finally {
+					state.returned = true;
+				}
+			},
+		}));
+		pi.registerTool(defineTool({
+			name: "target", label: "Target", description: "In-memory effect", parameters: Type.Object({}),
+			async execute() {
+				effects.push("target");
+				return textResult("usable target content");
+			},
+		}));
+		// Real typed handlers: runner must observe the first rejection, then the later veto.
+		pi.on("session_before_switch", () => { if (failBeforeCancel) throw new Error(hookFailure); });
+		pi.on("session_before_fork", () => { if (failBeforeCancel) throw new Error(hookFailure); });
+		pi.on("session_before_switch", async (event) => {
+			beforeEvents.push(event);
+			await before.wait();
+			return { cancel: true };
+		});
+		pi.on("session_before_fork", async (event) => {
+			beforeEvents.push(event);
+			await before.wait();
+			return { cancel: true };
+		});
+		pi.on("session_start", (event) => { lifecycle.push(`start:${factoryGeneration}:${event.reason}`); });
+		pi.on("session_shutdown", (event) => { lifecycle.push(`shutdown:${factoryGeneration}:${event.reason}`); });
+	};
+	async function loadExtensions(): Promise<LoadExtensionsResult> {
+		const runtime = createExtensionRuntime();
+		const extension = await loadExtensionFromFactory(factory, cwd, createEventBus(), runtime, "<inline:b2>");
+		return { extensions: [extension], errors: [], runtime };
+	}
+	async function settle(): Promise<unknown[]> {
+		for (const pause of gates) pause.release();
+		await Promise.allSettled(pending);
+		// Settling a prompt/reload can register its nested invocation/loader promise.
+		const results = await Promise.allSettled(pending);
+		return results.flatMap((result) => result.status === "rejected" ? [result.reason] : []);
+	}
+	function retire() {
+		try { createdSession?.dispose(); }
+		finally {
+			try { currentFaux?.unregister(); }
+			finally { rmSync(cwd, { recursive: true }); }
+		}
+	}
+
+	try {
+		const credentials = new InMemoryCredentialStore();
+		await credentials.modify("anthropic", async () => ({ type: "api_key", key: "b2-faux-key" }));
+		const modelRuntime = await ModelRuntime.create({
+			credentials, modelsPath: null, allowModelNetwork: false, refreshOnCreate: false,
+		});
+		const model = installFaux().getModel();
+		const sessionManager = SessionManager.inMemory(cwd);
+		const settingsManager = SettingsManager.inMemory({ retry: { enabled: false }, compaction: { enabled: false } });
+		const agent = new Agent({
+			getApiKey: () => "b2-faux-key", streamFn: streamSimple, convertToLlm,
+			initialState: { model, tools: [], systemPrompt: "" },
+		});
+		let extensionsResult = await loadExtensions();
+		const resourceLoader: ResourceLoader = {
+			getExtensions: () => extensionsResult,
+			getSkills: () => ({ skills: [], diagnostics: [] }),
+			getPrompts: () => ({ prompts: [], diagnostics: [] }),
+			getThemes: () => ({ themes: [], diagnostics: [] }),
+			getAgentsFiles: () => ({ agentsFiles: [] }),
+			getSystemPrompt: () => "", getSystemPromptSource: () => undefined,
+			getAppendSystemPrompt: () => [], getAppendSystemPromptSources: () => [],
+			extendResources: () => {},
+			reload: () => own((async () => {
+				installFaux();
+				extensionsResult = await loadExtensions();
+				lifecycle.push(`loader:${generation}`);
+			})()),
+		};
+		const session: AgentSession = new AgentSession({
+			agent, sessionManager, settingsManager, cwd, modelRuntime, resourceLoader, baseToolsOverride: {},
+			toolInvocationPolicy: (request) => {
+				const registrations = session.extensionRunner.getAllRegisteredTools();
+				return request.caller === registrations.find((tool) => tool.definition.name === "owner") &&
+					request.target === registrations.find((tool) => tool.definition.name === "target") &&
+					request.sessionId === session.sessionId && request.cwd === cwd;
+			},
+		});
+		createdSession = session;
+		await session.bindExtensions({ onError: (error) => { errors.push(error); } });
+		const runtime = new AgentSessionRuntime(session, {
+			cwd, agentDir: cwd, modelRuntime, settingsManager, resourceLoader, diagnostics: [],
+		}, async () => { throw new Error("B2 replacement factory must not be called"); });
+		return {
+			session, runtime, cwd, before, beforeEvents, effects, lifecycle, errors, own,
+			begin(kind: ReplacementKind) {
+				if (kind === "new") return own(runtime.newSession());
+				if (kind === "switch") return own(runtime.switchSession(join(cwd, "missing-session.jsonl")));
+				return own(runtime.fork("b2-missing-entry", { position: "at" }));
+			},
+			startOwner() {
+				const state: OwnerState = {
+					entered: deferred<ToolExecutionContext>(), result: deferred<ToolInvocationResult>(),
+					proceed: newGate(), finish: newGate(), attempts: 0, returned: false,
+				};
+				owners.push(state);
+				faux().setResponses([
+					fauxAssistantMessage(fauxToolCall("owner", {}, { id: `b2-root-${++rootId}` }), { stopReason: "toolUse" }),
