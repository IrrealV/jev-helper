diff --git a/packages/coding-agent/src/core/tool-invocation-scope.ts b/packages/coding-agent/src/core/tool-invocation-scope.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/core/tool-invocation-scope.ts
@@ -0,0 +1,19 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+
+// Internal only: the owning session's private frame is the identity, never a name or public context.
+const toolInvocationOrigin = new AsyncLocalStorage<object | undefined>();
+
+/** Enter only around the owning registered definition's execution. */
+export function runWithToolInvocationOrigin<T>(frame: object, execute: () => T): T {
+	return toolInvocationOrigin.run(frame, execute);
+}
+
+/** Clear this authority for a callback and its async descendants, restoring the caller on return. */
+export function withoutToolInvocationOrigin<T>(callback: () => T): T {
+	return toolInvocationOrigin.run(undefined, callback);
+}
+
+/** Compare identity without exposing the current frame to callers. */
+export function isToolInvocationOrigin(frame: object): boolean {
+	return toolInvocationOrigin.getStore() === frame;
+}
