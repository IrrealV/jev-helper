--- /dev/null
+++ b/packages/coding-agent/test/suite/agent-session-tool-invocation-origin.test.ts
@@ -0,0 +1,344 @@
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/compat";
+import { Type } from "typebox";
+import { describe, expect, it } from "vitest";
+import {
+	defineTool,
+	type ExtensionAPI,
+	type ExtensionError,
+	type ToolExecutionContext,
+	type ToolInvocationResult,
+	wrapRegisteredTool,
+} from "../../src/index.ts";
+import { createTestExtensionsResult, createTestResourceLoader } from "../utilities.ts";
+import { createHarness, type Harness } from "./harness.ts";
+
+type Boundary = "hook" | "supplied-hook" | "bus" | "peer" | "tool-call" | "tool-result" |
+	"session-listener" | "error-listener" | "command" | "standalone" | "owner-await";
+type Scenario = { name: string; boundary: Boundary; afterAwait: boolean };
+
+const cases = [
+	{ name: "registered update hook directly [A2-01]", boundary: "hook", afterAwait: false },
+	{ name: "registered update hook after await [A2-02]", boundary: "hook", afterAwait: true },
+	{ name: "supplied update handler directly [A2-03]", boundary: "supplied-hook", afterAwait: false },
+	{ name: "supplied update handler after await [A2-04]", boundary: "supplied-hook", afterAwait: true },
+	{ name: "event-bus listener directly [A2-05]", boundary: "bus", afterAwait: false },
+	{ name: "event-bus listener after await [A2-06]", boundary: "bus", afterAwait: true },
+	{ name: "parallel registered tool [A2-07]", boundary: "peer", afterAwait: false },
+	{ name: "tool_call hook on a parallel nested call [A2-08]", boundary: "tool-call", afterAwait: false },
+	{ name: "tool_result hook on a parallel nested call [A2-09]", boundary: "tool-result", afterAwait: false },
+	{ name: "public session listener directly [A2-10]", boundary: "session-listener", afterAwait: false },
+	{ name: "public session listener after await [A2-11]", boundary: "session-listener", afterAwait: true },
+	{ name: "runner error listener directly [A2-12]", boundary: "error-listener", afterAwait: false },
+	{ name: "runner error listener after await [A2-13]", boundary: "error-listener", afterAwait: true },
+	{ name: "extension command directly [A2-14]", boundary: "command", afterAwait: false },
+	{ name: "extension command after await [A2-15]", boundary: "command", afterAwait: true },
+	{ name: "standalone registered adapter directly [A2-16]", boundary: "standalone", afterAwait: false },
+	{ name: "standalone registered adapter after await [A2-17]", boundary: "standalone", afterAwait: true },
+] as const satisfies readonly Scenario[];
+
+function deferred() {
+	let resolve!: () => void;
+	const promise = new Promise<void>((fulfill) => { resolve = fulfill; });
+	return { promise, resolve };
+}
+
+function textResult(text: string) {
+	return { content: [{ type: "text" as const, text }], details: undefined };
+}
+
+async function fixture(scenario: Scenario) {
+	const { boundary, afterAwait } = scenario;
+	const parallel = boundary === "peer" || boundary === "tool-call" || boundary === "tool-result";
+	const peerFinished = deferred();
+	const pending: Promise<unknown>[] = [];
+	const borrowWork: Promise<void>[] = [];
+	const faults: string[] = [];
+	const errors: ExtensionError[] = [];
+	const effects: string[] = [];
+	const preparations: string[] = [];
+	const policies: string[] = [];
+	const borrowEffects: string[][] = [];
+	const borrowPreparations: string[][] = [];
+	const borrowPolicies: string[][] = [];
+	const borrowStates: Array<{ live: boolean; attempts: number; peerLive: boolean }> = [];
+	const borrowedResults: ToolInvocationResult[] = [];
+	const ownerResults: ToolInvocationResult[] = [];
+	const peerResults: ToolInvocationResult[] = [];
+	const commandArguments: string[] = [];
+	let api!: ExtensionAPI;
+	let harness!: Harness;
+	let borrowedInvoke: ToolExecutionContext["invokeTool"] | undefined;
+	let ownerLive = false;
+	let ownerAttempts = 0;
+	let peerLive = false;
+	let peerPrepared = false;
+
+	function track<T>(work: Promise<T>): Promise<T> {
+		pending.push(work);
+		// Observe detached listener rejections immediately; assertions remain outside host callbacks.
+		void work.catch((error: unknown) => { faults.push(String(error)); });
+		return work;
+	}
+
+	function beginBorrow(): Promise<void> {
+		const work = track((async () => {
+			if (afterAwait) await Promise.resolve();
+			borrowStates.push({ live: ownerLive, attempts: ownerAttempts, peerLive });
+			if (!borrowedInvoke) throw new Error("Borrowing callback ran before the owner minted its capability");
+			borrowedResults.push(await borrowedInvoke("target", { source: "borrowed" }));
+			// Captured before the owner is allowed its first attempt, not after owner completion.
+			borrowEffects.push([...effects]);
+			borrowPreparations.push([...preparations]);
+			borrowPolicies.push(policies.filter((name) => name === "owner->target"));
+		})());
+		borrowWork.push(work);
+		return work;
+	}
+
+	const target = defineTool({
+		name: "target", label: "Target", description: "Text-only origin target",
+		parameters: Type.Object({ source: Type.String() }), executionMode: "parallel",
+		prepareArguments(args) {
+			if (typeof args !== "object" || args === null || !("source" in args) || typeof args.source !== "string") {
+				throw new Error("Expected a synthetic source argument");
+			}
+			preparations.push(args.source);
+			return { source: args.source };
+		},
+		async execute(_id, args) {
+			effects.push(args.source);
+			return textResult(`target:${args.source}`);
+		},
+	});
+	const probe = defineTool({
+		name: "probe", label: "Probe", description: "Peer-owned synthetic child",
+		parameters: Type.Object({}), executionMode: "parallel",
+		async execute() { return textResult("probe completed"); },
+	});
+	const standalone = defineTool({
+		name: "standalone", label: "Standalone", description: "Non-owning adapter entry",
+		parameters: Type.Object({}), executionMode: "parallel",
+		async execute() {
+			await beginBorrow();
+			return textResult("standalone completed");
+		},
+	});
+	const owner = defineTool({
+		name: "owner", label: "Owner", description: "Real registered capability owner",
+		parameters: Type.Object({}), executionMode: "parallel",
+		async execute(_id, _args, signal, onUpdate, ctx) {
+			borrowedInvoke = ctx.invokeTool;
+			ownerLive = true;
+			try {
+				await Promise.resolve();
+				if (parallel) {
+					// Real parallel preflight precedes ALL execution. Never wait inside a root tool_call hook.
+					if (!peerPrepared) throw new Error("Peer preflight did not precede parallel owner execution");
+					await peerFinished.promise;
+				} else if (boundary === "hook" || boundary === "supplied-hook" || boundary === "error-listener") {
+					if (!onUpdate) throw new Error("Registered owner did not receive its actual update callback");
+					onUpdate(textResult("owner progress before first invocation"));
+				} else if (boundary === "bus") {
+					api.events.emit("a2:borrow", undefined);
+				} else if (boundary === "session-listener") {
+					// Empty-queue notification only: no persistence or replacement operation.
+					harness.session.clearQueue();
+				} else if (boundary === "command") {
+					// Public prompt dispatch handles registered commands before its streaming guard.
+					await track(harness.session.prompt("/origin-probe origin-argument"));
+				} else if (boundary === "standalone") {
+					const runner = harness.session.extensionRunner;
+					const registration = runner.getAllRegisteredTools().find((tool) => tool.definition === standalone);
+					if (!registration) throw new Error("Missing real standalone registration");
+					await track(wrapRegisteredTool(registration, runner).execute("standalone-call", {}, signal));
+				}
+				if (boundary !== "owner-await") {
+					// These entrypoints enter their callback synchronously (even an async descendant).
+					// Diagnose missing delivery instead of waiting forever on a callback-owned deferred.
+					if (borrowWork.length !== 1) throw new Error(`Expected exactly one ${boundary} borrowing callback`);
+					await borrowWork[0];
+				}
+				await Promise.resolve();
+				ownerAttempts++;
+				ownerResults.push(await track(ctx.invokeTool("target", { source: "owner" })));
+				await Promise.resolve();
+				ownerAttempts++;
+				ownerResults.push(await track(ctx.invokeTool("target", { source: "repeat" })));
+				return textResult("owner completed");
+			} finally {
+				ownerLive = false;
+			}
+		},
+	});
+	const peer = defineTool({
+		name: "peer", label: "Peer", description: "Real simultaneous registered execution",
+		parameters: Type.Object({}), executionMode: "parallel",
+		async execute(_id, _args, _signal, _onUpdate, ctx) {
+			peerLive = true;
+			try {
+				if (!ownerLive) throw new Error("Peer did not overlap a live owner execution");
+				if (boundary === "peer") await beginBorrow();
+				else peerResults.push(await track(ctx.invokeTool("probe", {})));
+				return textResult("peer completed");
+			} finally {
+				peerLive = false;
+				peerFinished.resolve();
+			}
+		},
+	});
+
+	const extensionsResult = await createTestExtensionsResult([{ name: "a2-origin", factory: (pi) => {
+		api = pi;
+		pi.registerTool(owner);
+		pi.registerTool(target);
+		pi.registerTool(peer);
+		pi.registerTool(probe);
+		pi.registerTool(standalone);
+		pi.on("tool_call", (event) => {
+			if (event.toolName === "peer") peerPrepared = true;
+			if (boundary === "tool-call" && event.toolName === "probe") return beginBorrow();
+		});
+		pi.on("tool_result", (event) => {
+			if (boundary === "tool-result" && event.toolName === "probe") return beginBorrow();
+		});
+		if (boundary === "hook") pi.on("tool_execution_update", () => beginBorrow());
+		if (boundary === "error-listener") {
+			pi.on("tool_execution_update", () => { throw new Error("A2 synthetic update failure"); });
+		}
+		if (boundary === "bus") pi.events.on("a2:borrow", () => beginBorrow());
+		pi.registerCommand("origin-probe", {
+			description: "In-process synthetic origin probe",
+			handler: async (args) => { commandArguments.push(args); await beginBorrow(); },
+		});
+	} }]);
+	if (boundary === "supplied-hook") {
+		// Public ResourceLoader input assembled before the SUT exists, not runner-field replacement.
+		// Bypasses pi.on so loader-only wrapping cannot satisfy these cases.
+		extensionsResult.extensions[0].handlers.set("tool_execution_update", [async () => { await beginBorrow(); }]);
+	}
+	harness = await createHarness({
+		tools: [], settings: { retry: { enabled: false }, compaction: { enabled: false } },
+		resourceLoader: createTestResourceLoader({ extensionsResult }),
+		toolInvocationPolicy: (request) => {
+			policies.push(`${request.caller.definition.name}->${request.target.definition.name}`);
+			return (request.caller.definition === owner && request.target.definition === target) ||
+				(request.caller.definition === peer && request.target.definition === probe);
+		},
+	});
+	const unsubscribe = harness.session.subscribe((event) => {
+		if (boundary === "session-listener" && event.type === "queue_update") void beginBorrow();
+	});
+	try {
+		await harness.session.bindExtensions({ mode: "print", onError: (error) => {
+			errors.push(error);
+			if (boundary === "error-listener" && error.event === "tool_execution_update" &&
+				error.error === "A2 synthetic update failure") void beginBorrow();
+		} });
+	} catch (error) {
+		peerFinished.resolve();
+		unsubscribe();
+		await Promise.allSettled(pending);
+		await harness.session.waitForIdle();
+		harness.cleanup();
+		throw error;
+	}
+	return {
+		harness, parallel, pending, faults, errors, effects, preparations, policies,
+		borrowEffects, borrowPreparations, borrowPolicies, borrowStates,
+		borrowedResults, ownerResults, peerResults, commandArguments,
+		release: peerFinished.resolve, unsubscribe,
+	};
+}
+
+type Fixture = Awaited<ReturnType<typeof fixture>>;
+
+function start(f: Fixture): Promise<void> {
+	const calls = [fauxToolCall("owner", {}, { id: "owner-root" })];
+	if (f.parallel) calls.push(fauxToolCall("peer", {}, { id: "peer-root" }));
+	f.harness.setResponses([
+		fauxAssistantMessage(calls, { stopReason: "toolUse" }),
+		fauxAssistantMessage("finished"),
+	]);
+	return f.harness.session.prompt("Exercise execution origins", { expandPromptTemplates: false });
+}
+
+async function settle(f: Fixture, prompt: Promise<void> | undefined) {
+	// Release first, including after a RED assertion; never remove a temp directory with work in flight.
+	f.release();
+	await Promise.allSettled(prompt ? [prompt] : []);
+	await Promise.allSettled(f.pending);
+	await f.harness.session.waitForIdle();
+	f.unsubscribe();
+	f.harness.cleanup();
+}
+
+function assertOwnerUse(f: Fixture) {
+	expect(f.ownerResults).toHaveLength(2);
+	expect(f.ownerResults[0]).toMatchObject({ isError: false, content: [{ type: "text", text: "target:owner" }] });
+	expect(f.ownerResults[1].isError).toBe(true);
+	expect(f.effects).toEqual(["owner"]);
+	expect(f.preparations).toEqual(["owner"]);
+	expect(f.policies.filter((name) => name === "owner->target")).toEqual(["owner->target"]);
+	expect(f.harness.getPendingResponseCount()).toBe(0);
+	expect(f.harness.session.messages.filter((message) => message.role === "assistant")).toHaveLength(2);
+}
+
+// Predictions are declared before execution. No new scope module, private fields, or fake dispatch.
+describe("AgentSession A2 invocation origins", () => {
+	for (const scenario of cases) {
+		it(`should reject borrowing from ${scenario.name}`, async () => {
+			const f = await fixture(scenario);
+			let prompt: Promise<void> | undefined;
+			try {
+				expect(f.harness.session.agent.toolExecution).toBe("parallel");
+				prompt = start(f);
+				await prompt;
+				await f.harness.session.waitForIdle();
+				expect(f.faults, "Callback setup and execution must not fail").toEqual([]);
+				expect(f.harness.eventsOfType("tool_execution_end").map((event) => event.isError), "Root executions must settle normally")
+					.toEqual(f.parallel ? [false, false] : [false]);
+				expect(f.errors.map(({ event, error }) => ({ event, error }))).toEqual(scenario.boundary === "error-listener"
+					? [{ event: "tool_execution_update", error: "A2 synthetic update failure" }] : []);
+				expect(f.borrowStates, "Callback must borrow the live unused owner, not an expired or consumed capability")
+					.toEqual([{ live: true, attempts: 0, peerLive: f.parallel }]);
+				if (scenario.boundary === "tool-call" || scenario.boundary === "tool-result") {
+					expect(f.peerResults).toHaveLength(1);
+					expect(f.peerResults[0]).toMatchObject({ isError: false, content: [{ type: "text", text: "probe completed" }] });
+				}
+				expect(f.commandArguments).toEqual(scenario.boundary === "command" ? ["origin-argument"] : []);
+
+				// First intended RED assertion: accepted A1 executes the borrowed target, yielding [["borrowed"]].
+				expect(f.borrowEffects, "A2 origin: unauthorized target effects").toEqual([[]]);
+				expect(f.borrowPreparations).toEqual([[]]);
+				expect(f.borrowPolicies).toEqual([[]]);
+				expect(f.borrowedResults).toHaveLength(1);
+				expect(f.borrowedResults[0].isError).toBe(true);
+				assertOwnerUse(f);
+				expect(f.harness.session.getToolInvocationRecords().filter((record) => record.callerName === "owner")
+					.map(({ status, execution }) => ({ status, execution }))).toEqual([
+					{ status: "denied", execution: "not-entered" },
+					{ status: "completed", execution: "entered" },
+					{ status: "denied", execution: "not-entered" },
+				]);
+			} finally {
+				await settle(f, prompt);
+			}
+		});
