+// Added after the real neutral exports exist: GREEN-to-GREEN parity, not behavioral RED.
+describe("origin-neutral tool phases", () => {
+	it("should prepare, execute and finalize without an assistant or transcript mutation", async () => {
+		const raw = call();
+		raw.arguments = { legacy: "raw" };
+		const signal = new AbortController().signal;
+		const events: AgentEvent[] = [];
+		const original = result();
+		let validated: unknown;
+		const context: AgentContext = { messages: [], tools: [tool({
+			prepareArguments: (args) => {
+				expect(args).toBe(raw.arguments);
+				return { value: "prepared" };
+			},
+			execute: async (id, args, receivedSignal, update) => {
+				expect(id).toBe(raw.id);
+				expect(args).toBe(validated);
+				expect(args.value).toBe("mutated");
+				expect(receivedSignal).toBe(signal);
+				update?.(result("progress"));
+				return original;
+			},
+		})] };
+		const hooks: ToolInvocationHooks = {
+			beforeToolCall: async (input, receivedSignal) => {
+				expect(input).not.toHaveProperty("assistantMessage");
+				expect(input.context).toBe(context);
+				expect(input.toolCall).toBe(raw);
+				expect(receivedSignal).toBe(signal);
+				expect(input.args).toEqual({ value: "prepared" });
+				validated = input.args;
+				(input.args as { value: string }).value = "mutated";
+				return undefined;
+			},
+			afterToolCall: async (input, receivedSignal) => {
+				expect(input).not.toHaveProperty("assistantMessage");
+				expect(input.context).toBe(context);
+				expect(input.toolCall).toBe(raw);
+				expect(input.args).toBe(validated);
+				expect(input.result).toBe(original);
+				expect(input.isError).toBe(false);
+				expect(receivedSignal).toBe(signal);
+				return { usage: usage(8), terminate: true };
+			},
+		};
+
+		const prepared = await prepareToolInvocation(context, raw, hooks, signal);
+		if (prepared.kind !== "prepared") throw new Error("Expected prepared call");
+		const executed = await executePreparedToolCall(prepared, signal, (event) => { events.push(event); });
+		const finalized = await finalizeToolInvocation(context, prepared, executed, hooks, signal);
+
+		expect(finalized).toEqual({ toolCall: raw, result: { ...original, usage: usage(8), terminate: true }, isError: false });
+		expect(original.usage).toEqual(usage());
+		expect(raw.arguments).toEqual({ legacy: "raw" });
+		expect(context.messages).toEqual([]);
+		expect(events).toEqual([{
+			type: "tool_execution_update", toolCallId: raw.id, toolName: raw.name,
+			args: raw.arguments, partialResult: result("progress"),
+		}]);
+	});
+
+	it.each(["missing", "invalid", "prepare-error", "before-error", "deny", "abort", "abort-deny"] as const)(
+		"should preserve neutral preparation short-circuits (%s)", async (mode) => {
+			const visits: string[] = [];
+			const controller = new AbortController();
+			const context: AgentContext = { messages: [], tools: mode === "missing" ? [] : [tool({
+				prepareArguments: () => {
+					visits.push("prepare");
+					if (mode === "prepare-error") throw new Error("prepare failed");
+					return { value: mode === "invalid" ? "" : "prepared" };
+				},
+				execute: async () => { throw new Error("Must not execute"); },
+			})] };
+			const hooks: ToolInvocationHooks = {
+				beforeToolCall: async (input) => {
+					visits.push("before");
+					expect(input).not.toHaveProperty("assistantMessage");
+					expect(input.args).toEqual({ value: "prepared" });
+					if (mode === "before-error") throw "before failed";
+					if (mode === "abort-deny") controller.abort();
+					return { block: true, reason: "denied", terminate: true };
+				},
+			};
+			if (mode === "abort") controller.abort();
+
+			const prepared = await prepareToolInvocation(context, call(), hooks, controller.signal);
+
+			expect(visits).toEqual(mode === "missing" ? [] : mode === "invalid" || mode === "prepare-error"
+				? ["prepare"] : ["prepare", "before"]);
+			const text = mode === "missing" ? "Tool echo not found" : mode === "invalid" ? expect.stringContaining("value")
+				: mode === "prepare-error" ? "prepare failed" : mode === "before-error" ? "before failed"
+				: mode === "deny" ? "denied" : "Operation aborted";
+			expect(prepared).toEqual({
+				kind: "immediate", isError: true,
+				result: { content: [{ type: "text", text }], details: {}, ...(mode === "deny" ? { terminate: true } : {}) },
+			});
+			expect(context.messages).toEqual([]);
+		},
+	);
+
+	it.each(["plain", "override", "recover", "execute-error", "after-error"] as const)(
+		"should preserve neutral finalization errors and usage merging (%s)", async (mode) => {
+			const original = { ...result(), terminate: true };
+			const raw = call();
+			const context: AgentContext = { messages: [], tools: [tool({ execute: async () => {
+				if (mode === "recover" || mode === "execute-error") throw new Error("execute failed");
+				return original;
+			} })] };
+			const prepared = await prepareToolInvocation(context, raw, {}, undefined);
+			if (prepared.kind !== "prepared") throw new Error("Expected prepared call");
+			const executed = await executePreparedToolCall(prepared, undefined, () => {});
+			const hooks: ToolInvocationHooks = mode === "plain" ? {} : { afterToolCall: async (input) => {
+				expect(input).not.toHaveProperty("assistantMessage");
+				expect(input.result).toBe(executed.result);
+				expect(input.args).toBe(prepared.args);
+				expect(input.isError).toBe(mode === "recover" || mode === "execute-error");
+				if (mode === "after-error") throw new Error("after failed");
+				if (mode === "recover") return { content: [], details: { replacement: true }, usage: usage(9), isError: false, terminate: false };
+				return mode === "override" ? { usage: usage(8), isError: true, terminate: false } : undefined;
+			} };
+
+			const finalized = await finalizeToolInvocation(context, prepared, executed, hooks, undefined);
+
+			const expected = mode === "recover" ? { content: [], details: { replacement: true }, usage: usage(9), terminate: false }
+				: mode === "after-error" || mode === "execute-error" ? { content: [{ type: "text", text: mode === "after-error" ? "after failed" : "execute failed" }], details: {} }
+				: mode === "override" ? { ...original, usage: usage(8), terminate: false } : original;
+			expect(finalized).toEqual({ toolCall: raw, result: expected, isError: mode !== "plain" && mode !== "recover" });
+			if (mode === "plain" || mode === "execute-error") expect(finalized.result).toBe(executed.result);
+			expect(original).toEqual({ ...result(), terminate: true });
+			expect(context.messages).toEqual([]);
+		},
+	);
+});
